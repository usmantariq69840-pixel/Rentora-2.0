# Copy this file to .env — never commit the real .env file.
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
SESSION_SECRET=change-me-to-a-long-random-string

# Optional. You can also add, replace or delete the key in the app (admin > AI settings).
# A key saved in the app takes priority over this one. Keep it on the backend only.
GEMINI_API_KEY=
